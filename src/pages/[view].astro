---
import BaseLayout from "../layouts/BaseLayout.astro";
import EasterEgg from "../components/EasterEgg.astro";
import PortfolioMonitor from "../components/PortfolioMonitor.astro";
import { portfolioContacts } from "../lib/portfolio-catalog.js";
export function getStaticPaths() {
  return ["eyebrow-tattooing", "videography", "photography", "dance", "search", "contacts"]
    .map((view) => ({ params: { view }, props: { view } }));
}
const { view } = Astro.props;
---
<BaseLayout title={`${portfolioContacts.name} | Creative Portfolio`}>
  <PortfolioMonitor initialView={view} />
  <EasterEgg handle={portfolioContacts.handle} />
</BaseLayout>
