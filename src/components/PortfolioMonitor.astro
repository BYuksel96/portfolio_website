---
// @ts-nocheck
import { heroLandscapes, profile } from "../data/site.js";
import { portfolioContacts, portfolioFolders } from "../lib/portfolio-catalog.js";
const { initialView = "home" } = Astro.props;
const isHome = initialView === "home";
const icons = {
  search: "M11 4a7 7 0 1 0 4.9 12l4.6 4.5 1.4-1.4-4.5-4.6A7 7 0 0 0 11 4Zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z",
  contacts: "M7 3h10a3 3 0 0 1 3 3v14H7a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Zm2 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm-2 8c-1.3 0-2 .8-2 2v1h8v-1c0-1.2-.7-2-2-2H7Zm9-8h2v2h-2V7Zm0 4h2v2h-2v-2Z",
  home: "m3 11 9-8 9 8v10h-7v-6h-4v6H3V11Z"
};
const letters = (value) => [...value];
---
<main class="monitor-stage">
  <section class={`monitor-app ${isHome ? "is-home" : "is-workspace"}`} data-monitor-app data-initial-view={initialView} data-email={portfolioContacts.email} data-landscapes={JSON.stringify(heroLandscapes.map(({ src }) => src))}>
    <div class="split-flap-board" aria-hidden="true">
      {Array.from({ length: 24 }).map(() => <span class="split-flap-tile"><span class="split-flap-card"><span class="split-flap-face split-flap-face-front"></span><span class="split-flap-face split-flap-face-back"></span></span></span>)}
    </div>
    <header class="monitor-bar" aria-label="Portfolio status">
      <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{profile.location}</span><span>Portfolio OS</span>
    </header>

    <section class="home-scene" data-home-scene aria-hidden={!isHome} aria-labelledby="page-title">
      <div class="hero-copy">
        <p class="eyebrow" aria-label={portfolioContacts.handle}>{letters(portfolioContacts.handle).map((letter, index) => <span class="crumble-char" style={`--i:${index}`}>{letter}</span>)}</p>
        <h1 id="page-title" aria-label={portfolioContacts.name}>{portfolioContacts.name.split(" ").map((word, wordIndex) => <span class="crumble-word">{letters(word).map((letter, index) => <span class="crumble-char" style={`--i:${wordIndex * 10 + index}`}>{letter}</span>)}</span>)}</h1>
        <p aria-label={portfolioContacts.headline}>{letters(portfolioContacts.headline).map((letter, index) => <span class="crumble-char" style={`--i:${index}`}>{letter === " " ? "\u00a0" : letter}</span>)}</p>
      </div>
      <form class="home-search" data-home-search role="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.search}></path></svg>
        <label class="sr-only" for="home-search">Search the portfolio</label>
        <input id="home-search" type="search" placeholder="Search folders, tags, posts" autocomplete="off" />
      </form>
      <nav class="scattered-folders" aria-label="Portfolio folders">
        {portfolioFolders.map((folder, index) => (
          <button type="button" class={`scattered-folder folder-${folder.color}`} data-view={folder.slug} style={`--accent:${folder.accent};--folder-index:${index}`}>
            <span class="folder-stack" aria-hidden="true"><span class="folder-back"></span><span class="folder-previews">{folder.posts.map((post, postIndex) => <span class={`folder-polaroid preview-${postIndex + 1}`}><img src={post.mediaUrl} alt="" /></span>)}</span><span class="folder-front"></span></span>
            <span>{folder.title}</span>
          </button>
        ))}
      </nav>
      <aside class="airdrop-card" data-airdrop aria-label="Profile introduction">
        <strong>AirDrop</strong><p>{portfolioContacts.intro}</p><button type="button" data-airdrop-accept>Accept</button>
      </aside>
    </section>

    <div class="workspace" data-workspace aria-hidden={isHome}>
      <nav class="monitor-dock" aria-label="Portfolio controls">
        {portfolioFolders.map((folder) => (
          <button class={`dock-control dock-${folder.color}`} type="button" data-view={folder.slug} aria-current={initialView === folder.slug ? "page" : undefined} style={`--folder-color:${folder.accent}`}>
            <span class="dock-icon" aria-hidden="true"><span class="folder-stack dock-folder-stack"><span class="folder-back"></span><span class="folder-front"></span></span></span>
            <span>{folder.title}</span>
          </button>
        ))}
        <button class="dock-control" type="button" data-view="search" aria-current={initialView === "search" ? "page" : undefined}><span class="dock-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icons.search}></path></svg></span><span>Search</span></button>
        <button class="dock-control" type="button" data-view="contacts" aria-current={initialView === "contacts" ? "page" : undefined}><span class="dock-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icons.contacts}></path></svg></span><span>Contacts</span></button>
        <button class="dock-control" type="button" data-view="home"><span class="dock-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icons.home}></path></svg></span><span>Home</span></button>
      </nav>
      <div class="workspace-scroll" data-workspace-scroll tabindex="-1">
        {portfolioFolders.map((folder) => (
          <section class={`portfolio-view view-${folder.color}`} data-panel={folder.slug} style={`--accent:${folder.accent}`} hidden={initialView !== folder.slug}>
            <header class="view-header"><div><p class="view-kicker">Open folder / {folder.title}</p><h2 tabindex="-1" data-monitor-heading>{folder.title}</h2><p>{folder.description}</p></div><a class="social-link" href={folder.social.url} target="_blank" rel="noreferrer">Visit {folder.social.label} ↗</a></header>
            <div class="tag-row" aria-label={`${folder.title} disciplines`}>{folder.tags.map((tag) => <span>{tag}</span>)}</div>
            <section class="latest-preview" aria-label={`${folder.title} latest preview`}><div class="section-label"><span>Latest Preview</span><span>09 files · 3 × 3</span></div>
              <div class="featured-grid preview-grid">{folder.latestMedia.map((media, index) => <article class="featured-card"><div class="featured-media" style={`--c1:${media.palette[0]};--c2:${media.palette[1]};--c3:${media.palette[2]}`}><img src={media.mediaUrl} alt={media.alt} loading="lazy" /><span>{String(index + 1).padStart(2, "0")}</span></div><div class="featured-copy"><p>{media.type} · {media.date}</p><h3>{media.title}</h3><p>{media.description}</p></div></article>)}</div>
            </section>
          </section>
        ))}
        <section class="portfolio-view search-view" data-panel="search" hidden={initialView !== "search"}>
          <header class="view-header"><div><p class="view-kicker">Portfolio index</p><h2 tabindex="-1" data-monitor-heading>Search</h2><p>Search every folder, discipline, caption, and tag.</p></div></header>
          <form class="workspace-search" data-search-form role="search"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.search}></path></svg><label class="sr-only" for="workspace-search">Search all work</label><input id="workspace-search" name="q" type="search" placeholder="Try “portrait”, “movement”, or “beauty”" autocomplete="off" /></form>
          <div class="search-results" data-search-results>{portfolioFolders.map((folder) => <section class="search-group" data-search-group data-search-text={`${folder.title} ${folder.description} ${folder.tags.join(" ")}`}><div class="search-group-heading"><span class={`search-folder folder-${folder.color}`} aria-hidden="true"></span><h3>{folder.title}</h3></div><div class="search-result-list">{folder.posts.map((post) => <button type="button" data-view={folder.slug} data-search-result data-search-text={`${folder.title} ${folder.description} ${folder.tags.join(" ")} ${post.title} ${post.type} ${post.description} ${post.tags.join(" ")}`}><span>{post.type}</span><strong>{post.title}</strong><span>Open folder →</span></button>)}</div></section>)}</div>
          <p class="search-empty" data-search-empty hidden>No work matched that search. Try a folder name, discipline, or tag.</p>
        </section>
        <section class="portfolio-view contacts-view" data-panel="contacts" hidden={initialView !== "contacts"}>
          <header class="view-header"><div><p class="view-kicker">Contacts.app</p><h2 tabindex="-1" data-monitor-heading>Let’s make something.</h2><p>{portfolioContacts.intro}</p></div></header>
          <div class="contacts-layout"><section class="contact-card"><div class="contact-avatar" aria-hidden="true">C</div><div><p class="eyebrow">{portfolioContacts.handle}</p><h3>{portfolioContacts.name}</h3><p>{portfolioContacts.headline}</p></div><a href={`mailto:${portfolioContacts.email}`}>{portfolioContacts.email}</a>{portfolioContacts.socials.map((social) => <a href={social.url} target="_blank" rel="noreferrer">{social.label} ↗</a>)}</section>
            <form class="contact-form" data-contact-form><label>Name<input name="name" autocomplete="name" required /></label><label>Email<input name="email" type="email" autocomplete="email" required /></label><label>Project type<select name="project"><option>Photography</option><option>Videography</option><option>Dance</option><option>Eyebrow tattooing</option><option>Something else</option></select></label><label>Tell me about it<textarea name="message" rows="4" required></textarea></label><button type="submit">Compose enquiry <span>↗</span></button><p>This opens your email app with the details ready to send.</p></form>
          </div>
          <details class="next-step"><summary>Next step</summary><h3>Make the profile easy to book, share, and trust.</h3><p>Replace the placeholder content with approved creator details, then connect selected social posts and a booking flow for eyebrow tattooing consultations.</p><ul>{portfolioContacts.notes.map((note) => <li>{note}</li>)}</ul></details>
        </section>
      </div>
    </div>
  </section>
</main>

<script>
  // @ts-nocheck
  const app = document.querySelector("[data-monitor-app]");
  if (!(app instanceof HTMLElement)) throw new Error("Portfolio monitor failed to initialise");
  const validViews = new Set(["home", "eyebrow-tattooing", "videography", "photography", "dance", "search", "contacts"]);
  const panels = [...app.querySelectorAll("[data-panel]")];
  const controls = [...app.querySelectorAll("[data-view]")];
  const homeScene = app.querySelector("[data-home-scene]");
  const workspace = app.querySelector("[data-workspace]");
  const scroller = app.querySelector("[data-workspace-scroll]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const controlMotionDuration = 1400;
  const homeTransitionDuration = 1500;
  let activeView = app.dataset.initialView || "home";
  let timer = 0;
  let controlAnimations = [];
  function clearControlAnimations() {
    controlAnimations.forEach((animation) => animation.cancel());
    controlAnimations = [];
  }
  const routeView = () => { const slug = location.pathname.replace(/^\/+|\/+$/g, "") || "home"; return validViews.has(slug) ? slug : "home"; };
  const pathFor = (view, query = "") => view === "home" ? "/" : view === "search" && query ? `/search?q=${encodeURIComponent(query)}` : `/${view}`;

  function render(view, focus = false) {
    clearControlAnimations();
    activeView = view;
    const home = view === "home";
    app.classList.toggle("is-home", home); app.classList.toggle("is-workspace", !home);
    app.classList.remove("is-transitioning", "is-leaving-home", "is-returning-home"); app.dataset.activeView = view;
    homeScene?.setAttribute("aria-hidden", String(!home)); workspace?.setAttribute("aria-hidden", String(home));
    homeScene?.toggleAttribute("inert", !home); workspace?.toggleAttribute("inert", home);
    panels.forEach((panel) => { if (panel instanceof HTMLElement) panel.hidden = panel.dataset.panel !== view; });
    controls.forEach((control) => { if (!(control instanceof HTMLElement)) return; const current = !home && control.dataset.view === view; control.removeAttribute("aria-current"); if (current) control.setAttribute("aria-current", "page"); });
    if (scroller instanceof HTMLElement) scroller.scrollTop = 0;
    if (view === "search") syncQuery();
    if (focus) { const target = home ? app.querySelector(".scattered-folder") : app.querySelector(`[data-panel="${view}"] [data-monitor-heading]`); if (target instanceof HTMLElement) target.focus({ preventScroll: true }); }
  }
  function navigate(view, { push = true, focus = true, query = "" } = {}) {
  function animateDesktopControls(toDock) {
    if (reducedMotion.matches) return;
    clearControlAnimations();
    const elements = [...app.querySelectorAll(".scattered-folder")];
    elements.forEach((element) => {
      if (!(element instanceof HTMLElement)) return;
      const target = app.querySelector(`.dock-control[data-view="${element.dataset.view}"] .dock-icon`);
      if (!(target instanceof HTMLElement)) return;
      const sourceRect = element.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();
      const dx = targetRect.left + targetRect.width / 2 - (sourceRect.left + sourceRect.width / 2);
      const dy = targetRect.top + targetRect.height / 2 - (sourceRect.top + sourceRect.height / 2);
      const travel = `translate(${dx}px, ${dy}px) scale(.42)`;
      const frames = toDock ? [{ transform: "none", opacity: 1 }, { transform: travel, opacity: .9, offset: .82 }, { transform: travel, opacity: 0 }] : [{ transform: travel, opacity: 0 }, { transform: travel, opacity: .9, offset: .18 }, { transform: "none", opacity: 1 }];
      const animation = element.animate(frames, { duration: controlMotionDuration, easing: "cubic-bezier(.2,.8,.2,1)", fill: "both" });
      controlAnimations.push(animation);
    });
    const searchTarget = app.querySelector('.dock-control[data-view="search"] .dock-icon');
    const searchElement = app.querySelector("[data-home-search]");
    if (searchElement instanceof HTMLElement && searchTarget instanceof HTMLElement) {
      const sourceRect = searchElement.getBoundingClientRect();
      const targetRect = searchTarget.getBoundingClientRect();
      const dx = targetRect.left + targetRect.width / 2 - (sourceRect.left + sourceRect.width / 2);
      const dy = targetRect.top + targetRect.height / 2 - (sourceRect.top + sourceRect.height / 2);
      const travel = `translateX(-50%) translate(${dx}px, ${dy}px) scale(.18)`;
      const frames = toDock ? [{ transform: "translateX(-50%)", opacity: 1 }, { transform: travel, opacity: .9, offset: .82 }, { transform: travel, opacity: 0 }] : [{ transform: travel, opacity: 0 }, { transform: travel, opacity: .9, offset: .18 }, { transform: "translateX(-50%)", opacity: 1 }];
      const animation = searchElement.animate(frames, { duration: controlMotionDuration, easing: "cubic-bezier(.2,.8,.2,1)", fill: "both" });
      controlAnimations.push(animation);
    }
  }
    if (!validViews.has(view) || (view === activeView && view !== "search")) return;
    clearTimeout(timer); const leaving = activeView === "home" && view !== "home"; const returning = activeView !== "home" && view === "home";
    app.classList.add("is-transitioning"); app.classList.toggle("is-leaving-home", leaving); app.classList.toggle("is-returning-home", returning);
    if (push) history.pushState({ view }, "", pathFor(view, query));
    if (leaving || returning) animateDesktopControls(leaving ? true : false);
    timer = window.setTimeout(() => render(view, focus), reducedMotion.matches ? 0 : leaving || returning ? homeTransitionDuration : 150);
  }
  controls.forEach((control) => control.addEventListener("click", () => { if (control instanceof HTMLElement) navigate(control.dataset.view || "home"); }));
  app.querySelector("[data-airdrop-accept]")?.addEventListener("click", () => navigate("contacts"));
  window.addEventListener("popstate", () => { clearTimeout(timer); render(routeView(), true); });

  const homeSearch = app.querySelector("[data-home-search]");
  homeSearch?.addEventListener("submit", (event) => { event.preventDefault(); const input = homeSearch.querySelector("input"); const query = input instanceof HTMLInputElement ? input.value.trim() : ""; navigate("search", { query }); });
  const searchInput = app.querySelector("#workspace-search"); const groups = [...app.querySelectorAll("[data-search-group]")]; const empty = app.querySelector("[data-search-empty]");
  function filter(query) { const value = query.toLowerCase().trim(); let visible = 0; groups.forEach((group) => { if (!(group instanceof HTMLElement)) return; let count = 0; group.querySelectorAll("[data-search-result]").forEach((result) => { if (!(result instanceof HTMLElement)) return; const match = !value || (result.dataset.searchText || "").toLowerCase().includes(value); result.hidden = !match; if (match) count++; }); group.hidden = count === 0; visible += count; }); if (empty instanceof HTMLElement) empty.hidden = visible > 0; }
  function setQuery(value) { if (!(searchInput instanceof HTMLInputElement)) return; searchInput.value = value; filter(value); searchInput.focus(); }
  function syncQuery() { setQuery(new URLSearchParams(location.search).get("q") || ""); }
  searchInput?.addEventListener("input", () => { if (!(searchInput instanceof HTMLInputElement)) return; filter(searchInput.value); history.replaceState({ view: "search" }, "", pathFor("search", searchInput.value.trim())); });
  app.querySelector("[data-search-form]")?.addEventListener("submit", (event) => event.preventDefault());
  const form = app.querySelector("[data-contact-form]");
  form?.addEventListener("submit", (event) => { event.preventDefault(); if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return; const data = new FormData(form); const subject = `${data.get("project")} enquiry from ${data.get("name")}`; const body = `Name: ${data.get("name")}\nEmail: ${data.get("email")}\nProject: ${data.get("project")}\n\n${data.get("message")}`; location.href = `mailto:${app.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`; });

  const tiles = [...app.querySelectorAll(".split-flap-tile")]; const images = JSON.parse(app.dataset.landscapes || "[]");
  function face(tile, selector, source, index) { const item = tile.querySelector(selector); if (!(item instanceof HTMLElement)) return; item.style.backgroundImage = `url("${source}")`; item.style.backgroundSize = `${tiles.length * 100}% 100%`; item.style.backgroundPosition = `${index / Math.max(1, tiles.length - 1) * 100}% center`; }
  if (images.length && tiles.length) tiles.forEach((tile, index) => face(tile, ".split-flap-face-front", images[0], index));
  if (images.length > 1 && tiles.length && !reducedMotion.matches) { let current = 0; const cycle = () => { const next = (current + 1) % images.length; tiles.forEach((tile, index) => setTimeout(() => { face(tile, ".split-flap-face-back", images[next], index); tile.classList.add("is-flipping"); setTimeout(() => { face(tile, ".split-flap-face-front", images[next], index); tile.classList.add("is-resetting"); tile.classList.remove("is-flipping"); requestAnimationFrame(() => requestAnimationFrame(() => tile.classList.remove("is-resetting"))); }, 760); }, index * 70)); current = next; setTimeout(cycle, tiles.length * 70 + 5700); }; setTimeout(cycle, 5000); }
  render(routeView()); if (routeView() === "search") syncQuery();
</script>

<style is:global>
  .monitor-stage{height:100svh;padding:clamp(6px,1.4vw,22px);overflow:hidden;background:radial-gradient(circle at 15% 20%,#d5eff5,transparent 26%),radial-gradient(circle at 84% 15%,#fff0c4,transparent 30%),#dfe7e3}
  .monitor-app{position:relative;height:100%;min-height:0;overflow:hidden;border:1px solid rgba(255,255,255,.8);border-radius:clamp(18px,2vw,30px);background:rgba(255,255,255,.2);box-shadow:0 24px 80px rgba(17,22,20,.2);isolation:isolate}
  .split-flap-board{position:absolute;inset:0;z-index:-2;display:grid;grid-template-columns:repeat(24,1fr);overflow:hidden;opacity:.44;perspective:1200px}
  .split-flap-board:after{position:absolute;inset:0;content:"";background:linear-gradient(90deg,rgba(255,255,255,.7),rgba(255,255,255,.2) 45%,rgba(255,255,255,.55)),repeating-linear-gradient(90deg,transparent 0,transparent calc(100%/24 - 1px),#fff calc(100%/24 - 1px),#fff calc(100%/24));pointer-events:none}
  .split-flap-tile,.split-flap-card,.split-flap-face{position:relative;display:block;height:100%}.split-flap-card,.split-flap-face{position:absolute;inset:0}.split-flap-card{transform-style:preserve-3d;transition:transform .76s cubic-bezier(.32,.02,.2,1)}.split-flap-face{background-repeat:no-repeat;backface-visibility:hidden}.split-flap-face-back{transform:rotateY(180deg)}.split-flap-tile.is-flipping .split-flap-card{transform:rotateY(180deg)}.split-flap-tile.is-resetting .split-flap-card{transition:none}
  .monitor-bar{position:absolute;inset:0 0 auto;z-index:20;display:flex;justify-content:space-between;padding:12px 18px;color:#292d2b;font-size:.72rem;font-weight:800}.window-dots{display:flex;gap:6px}.window-dots i{width:10px;height:10px;border-radius:50%;background:#252827}
  .home-scene{position:absolute;inset:0;transition:opacity .24s ease}.is-workspace .home-scene{opacity:0;visibility:hidden;pointer-events:none}.is-returning-home .home-scene{opacity:1;visibility:visible;pointer-events:none}.hero-copy{position:absolute;z-index:3;left:clamp(28px,5vw,92px);top:clamp(100px,17vh,180px);width:min(44vw,690px)}.eyebrow{margin:0 0 12px;color:#505653;font-size:.72rem;font-weight:850;text-transform:uppercase}.hero-copy h1{margin:0;color:#fff;font-size:clamp(5rem,9vw,10rem);line-height:.84;letter-spacing:-.07em;text-shadow:0 12px 38px rgba(0,0,0,.22)}.hero-copy>p:last-child{max-width:450px;margin:22px 0 0;font-size:clamp(.95rem,1.15vw,1.2rem);font-weight:650;line-height:1.45}.crumble-word{display:inline-block;white-space:nowrap}.crumble-word:not(:last-child){margin-right:.16em}.crumble-char{display:inline-block;white-space:pre}.is-leaving-home .crumble-char{animation:crumble .55s cubic-bezier(.55,.04,.95,.35) both;animation-delay:calc(var(--i)*9ms)}.is-returning-home .crumble-char{animation:restore .5s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i)*7ms)}
  .is-returning-home .home-scene{z-index:9}
  .home-search{position:absolute;z-index:5;top:13%;left:50%;display:flex;align-items:center;gap:10px;width:min(390px,31vw);min-height:52px;padding:8px 16px;border:2px solid #181818;border-radius:999px;background:#fff;transform:translateX(-50%);box-shadow:0 12px 26px rgba(0,0,0,.12);transition:.5s cubic-bezier(.2,.8,.2,1)}.home-search svg,.workspace-search svg,.dock-icon svg{width:22px;fill:currentColor}.home-search input,.workspace-search input{width:100%;border:0;outline:0;background:transparent}
