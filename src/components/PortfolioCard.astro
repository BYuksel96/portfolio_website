---
import PortfolioCarousel from "./PortfolioCarousel.astro";
const { media, index } = Astro.props;
const video = media.mediaType === "video";
const ratio = media.width > 0 && media.height > 0 ? `${media.width} / ${media.height}` : "9 / 16";
const characters = Array.from(String(media.title));
const shortened = characters.length > 240;
const limit = Math.min(240, Math.floor(characters.length / 2));
const prefix = characters.slice(0, limit).join("");
const preview = shortened ? `${(/\s/u.test(characters[limit]) ? prefix : prefix.replace(/\s+\S*$/u, "")).trimEnd()}...` : media.title;
---
<article class="featured-card">
  <div class:list={["featured-media", { "has-video": video }]} style={`--c1:${media.palette[0]};--c2:${media.palette[1]};--c3:${media.palette[2]};--video-ratio:${ratio}`}>
    {video ? <>
      <video data-social-video data-src={media.mediaUrl} poster={media.posterUrl} preload="none" playsinline aria-label={media.alt}></video>
      <button class="play-social" type="button" data-play-social aria-label="Play video"><span aria-hidden="true">▶</span><span>Play video</span></button>
      <button class="close-social" type="button" data-close-social aria-label="Close video" hidden><span aria-hidden="true"></span></button>
      <p class="media-error" data-media-error role="status" hidden>Could not play this video. Use the original post link below.</p>
    </> : media.slides?.length > 1 ? <PortfolioCarousel media={media} index={index} />
      : media.permalink ? <a class="media-link" href={media.permalink} target="_blank" rel="noopener noreferrer"><img src={media.mediaUrl} alt={media.alt} loading="lazy" /></a>
      : <img src={media.mediaUrl} alt={media.alt} loading="lazy" />}
    {media.previewOnly && <p class="media-preview-label">Video preview · watch on Instagram</p>}
    <span class="media-number" aria-label={`Post ${index + 1}`}>{String(index + 1).padStart(2, "0")}</span>
  </div>
  <div class="featured-copy">
    <p>{media.publishedAt ? <time datetime={media.publishedAt}>{media.date}</time> : media.date}</p>
    <h3>{video ? <button class="caption-action" type="button" data-play-caption aria-description="Play video and read full caption"><span data-caption-preview>{preview}</span>{shortened && <span data-caption-full hidden>{media.title}</span>}</button>
      : media.permalink ? <a class="caption-action" href={media.permalink} target="_blank" rel="noopener noreferrer">{preview}</a> : preview}</h3>
    <p>{media.description}</p>
    {media.permalink && <a class="original-post" href={media.permalink} target="_blank" rel="noopener noreferrer">{media.previewOnly ? "Watch reel on Instagram" : "View original post"} <span aria-hidden="true">↗</span></a>}
  </div>
</article>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>(".featured-media.has-video")];

  function expandCaption(card: HTMLElement, expanded: boolean) {
    const article = card.closest(".featured-card");
    const full = article?.querySelector<HTMLElement>("[data-caption-full]");
    const preview = article?.querySelector<HTMLElement>("[data-caption-preview]");
    if (full && preview) { full.hidden = !expanded; preview.hidden = expanded; }
  }

  function closeVideo(card: HTMLElement, focus = false) {
    const video = card.querySelector<HTMLVideoElement>("video");
    video?.pause();
    if (video) video.controls = false;
    card.classList.remove("is-playing");
    expandCaption(card, false);
    const close = card.querySelector<HTMLButtonElement>("[data-close-social]");
    if (close) close.hidden = true;
    const error = card.querySelector<HTMLElement>("[data-media-error]");
    if (error) error.hidden = true;
    if (focus) card.querySelector<HTMLButtonElement>("[data-play-social]")?.focus({ preventScroll: true });
  }

  for (const card of cards) {
    const video = card.querySelector<HTMLVideoElement>("video");
    const play = card.querySelector<HTMLButtonElement>("[data-play-social]");
    const close = card.querySelector<HTMLButtonElement>("[data-close-social]");
    const error = card.querySelector<HTMLElement>("[data-media-error]");
    const caption = card.closest(".featured-card")?.querySelector<HTMLButtonElement>("[data-play-caption]");
    const openVideo = async () => {
      if (!video || !close) return;
      cards.filter(other => other !== card).forEach(other => closeVideo(other));
      if (error) error.hidden = true;
      if (!video.getAttribute("src")) video.src = video.dataset.src!;
      video.controls = true;
      card.classList.add("is-playing");
      expandCaption(card, true);
      close.hidden = false;
      close.focus({ preventScroll: true });
      try {
        await video.play();
        if (card.classList.contains("is-playing")) card.scrollIntoView({ block: "start", inline: "nearest" });
      } catch {
        if (!card.classList.contains("is-playing")) return;
        closeVideo(card);
        if (error) error.hidden = false;
        play?.focus({ preventScroll: true });
      }
    };
    play?.addEventListener("click", openVideo);
    caption?.addEventListener("click", () => { if (!card.classList.contains("is-playing")) void openVideo(); });
    close?.addEventListener("click", () => closeVideo(card, true));
  }
  const pauseAll = () => cards.forEach(card => closeVideo(card));
  document.addEventListener("keydown", event => {
    if (event.key === "Escape") {
      const active = cards.find(card => card.classList.contains("is-playing"));
      if (active) closeVideo(active, true);
    }
  });
  document.addEventListener("portfolio:view-changed", pauseAll);
  document.addEventListener("portfolio:easter-egg-open", pauseAll);
  window.addEventListener("pagehide", pauseAll);
  document.addEventListener("visibilitychange", () => { if (document.hidden) pauseAll(); });
</script>

<style>
  .featured-card{align-self:start;overflow:hidden;border:1px solid rgba(0,0,0,.14);border-radius:9px;background:rgba(255,255,255,.7);box-shadow:0 12px 30px rgba(0,0,0,.07)}
  .featured-media{position:relative;width:100%;aspect-ratio:4/3;overflow:hidden;background:linear-gradient(135deg,var(--c1),transparent),linear-gradient(45deg,var(--c2),var(--c3))}
  .featured-media img,.featured-media video,.media-link{display:block;width:100%;height:100%;object-fit:cover}
  .media-number{position:absolute;right:10px;bottom:8px;color:#fff;font-size:1.6rem;font-weight:900;text-shadow:0 2px 8px #000;pointer-events:none}
  .media-preview-label{position:absolute;left:8px;top:8px;max-width:calc(100% - 16px);margin:0;padding:5px 8px;border-radius:999px;background:rgba(0,0,0,.7);color:#fff;font-size:.65rem;font-weight:750;line-height:1.3;pointer-events:none}
  .featured-copy{padding:15px}.featured-copy>p:first-child{margin:0 0 8px;color:#777;font-size:.68rem;font-weight:800;text-transform:uppercase}
  .featured-copy h3{margin:0 0 8px;font-size:1.05rem;line-height:1.4;white-space:pre-line;overflow-wrap:anywhere}
  .caption-action{display:block;width:100%;margin:0;padding:0;border:0;background:none;color:inherit;font:inherit;font-weight:inherit;line-height:inherit;white-space:inherit;text-align:left;text-decoration:none;cursor:pointer}
  @media (hover:hover) and (pointer:fine){.caption-action:hover{text-decoration:underline;text-underline-offset:3px}}
  .featured-copy>p:last-of-type{margin:0;color:#606561;font-size:.86rem;line-height:1.45;overflow-wrap:anywhere}
  .original-post{display:inline-block;margin-top:12px;color:#272d29;font-size:.75rem;font-weight:700;text-underline-offset:3px}
  .play-social{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;border:0;background:linear-gradient(transparent,rgba(0,0,0,.25));color:#fff;text-shadow:0 2px 8px #000;font:inherit;font-size:.78rem;font-weight:800;cursor:pointer}
  .play-social>span:first-child{display:grid;place-items:center;padding-left:4px;width:54px;height:54px;border:1px solid rgba(255,255,255,.8);border-radius:50%;background:rgba(0,0,0,.45);font-size:1.4rem}
  .close-social{position:absolute;left:0;top:3px;z-index:2;display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;border-radius:50%;background:transparent;cursor:pointer;touch-action:manipulation}
  .close-social span{position:relative;display:block;box-sizing:border-box;width:24px;height:24px;border:1px solid rgba(96,12,12,.24);border-radius:50%;background:#f36b62;box-shadow:inset 0 1px 1px rgba(255,255,255,.55),0 3px 9px rgba(73,12,12,.2);transition:background .16s ease,transform .16s ease}
  .close-social span::before,.close-social span::after{content:"";position:absolute;left:6px;top:10px;width:10px;height:2px;border-radius:99px;background:#661c18;box-shadow:0 1px 0 rgba(255,255,255,.25);transform:rotate(45deg)}
  .close-social span::after{transform:rotate(-45deg)}
  .close-social:active span{transform:scale(.92)}
  .close-social:focus-visible{outline:none}.close-social:focus-visible span{outline:3px solid #f4c84a;outline-offset:3px}
  @media (hover:hover) and (pointer:fine){.close-social:hover span{background:#d94c43}}
  @media (prefers-reduced-motion:reduce){.close-social span{transition:none}}
  .is-playing{aspect-ratio:var(--video-ratio);max-height:min(760px,calc(100dvh - 180px));background:#111}.is-playing video{object-fit:contain}.is-playing .play-social{display:none}.is-playing .media-number{top:8px;bottom:auto}
  .media-error{position:absolute;left:8px;right:8px;bottom:8px;margin:0;padding:10px;background:#fff;color:#222;font-size:.75rem;line-height:1.4}
  [hidden]{display:none!important}.play-social:focus-visible,.media-link:focus-visible{outline:3px solid #f4c84a;outline-offset:-3px}
</style>
